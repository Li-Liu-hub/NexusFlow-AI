# 复制为 .env 并填入真实值（.env 不进 git）
GATEWAY_BASE_URL=http://localhost:8090
GATEWAY_ACCESS_KEY=
GATEWAY_SECRET_KEY=

LLM_API_KEY=
LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
LLM_MODEL=glm-5.2

# 库存告警定时巡检周期（秒）：编排层 alert 图每 N 秒跑一轮 scan→判定→notify（默认 600，≤0 关闭）
ALERT_INTERVAL_SECONDS=600

# Java 服务与灌库脚本共用（JVM 侧需配到系统环境变量：ZHIPU_AI_API_KEY / ZHIPU_EMBEDDING_API_KEY / PG_PASSWORD）
ZHIPU_EMBEDDING_API_KEY=
PG_PASSWORD=
