{
  "name": "aismp-frontend-user",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "终端 AI 智慧管理平台 · 用户端（对话界面）",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "npm run build:portal && npm run build:app",
    "build:app": "vite build",
    "build:portal": "vite build --config vite.portal.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "antd": "^5.22.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
