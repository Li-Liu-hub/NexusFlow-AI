# 复制为 .env 并填写（bootstrap.sh 会校验必填项）
# ⚠️ 本文件不入 git；凭据来源：服务器 /opt/agent-platform-secure/credentials.env

# ---- MySQL（容器 root 与应用账号）----
MYSQL_ROOT_PW=
MYSQL_APP_USER=api_user
MYSQL_APP_PW=

# ---- PostgreSQL（agent 用 my_user）----
PG_PW=

# ---- Redis ----
REDIS_PW=

# ---- RabbitMQ ----
RABBIT_USER=api_user
RABBIT_PW=

# ---- Nacos（鉴权）----
NACOS_AUTH_TOKEN=SecretKey0123456789012345678901234567890123456789012345678901234567890123
NACOS_IDENTITY_KEY=serverIdentity
NACOS_IDENTITY_VALUE=security

# ---- 网关调用凭证（数字员工内核 / 编排层 / backend 代理 共用）----
GW_ACCESS_KEY=aismp-console
GW_SECRET_KEY=7c1f9a3e5d0b2846af31c7e9b0d45268

# ---- LLM ----
MIMO_API_KEY=
SILICONFLOW_API_KEY=
