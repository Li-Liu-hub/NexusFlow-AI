<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.aismp</groupId>
    <artifactId>api-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>api-platform</name>
    <description>AI 接口开放平台（聚合工程）</description>

    <modules>
        <module>aismp-backend</module>
        <module>aismp-agent</module>
        <!-- 编排层（Spring AI Alibaba Graph）：替代原 Python agent-orchestrator，
             监听 8125，网关 /api/orchestrator/** 指向它 -->
        <module>aismp-orchestrator</module>
        <!--
          2026-10-11 架构评审修复：backend 的子模块此前游离在聚合之外。
          backend 自己是 packaging=jar 的**应用**（要打进可执行 jar），Maven 不允许
          jar 项目充当 aggregator（实测：'packaging' with value 'jar' is invalid.
          Aggregator projects require 'pom' as packaging），因此不能把 <modules> 加在
          aismp-backend/pom.xml 里，只能挂在已是 packaging=pom 的根聚合工程上。

          不纳入的后果（实测）：干净环境下
              mvn -B -q -DskipTests -f aismp-backend/pom.xml compile
              → Could not find artifact com.aismp:aismp-common:jar:0.0.1 in alimaven (EXIT=1)
          因为 backend/gateway 依赖的 com.aismp:aismp-common:0.0.1 与
          com.aismp:aismp-client-sdk:0.0.1 既不在聚合内、本地仓库又没有时无法解析。
        -->
        <module>aismp-backend/aismp-common</module>
        <module>aismp-backend/aismp-client-sdk</module>
        <module>aismp-backend/aismp-gateway</module>
    </modules>

</project>
